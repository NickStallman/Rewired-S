# Copy to secrets.yaml and fill in. secrets.yaml is git-ignored.
wifi_ssid: "MyWiFi"
wifi_password: "changeme"
# Password for the fallback hotspot (min 8 chars) that comes up when Wi-Fi is unreachable.
fallback_ap_password: "changeme123"
# 32-byte base64 key; generate your own with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# The value below is an example only (it lets `esphome config` validate); never deploy it.
api_encryption_key: "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
web_username: "admin"
web_password: "changeme"

# MQTT broker for per-device Home Assistant discovery (components/sungrow_mqtt).
mqtt_broker: "192.0.2.20"
mqtt_username: "mqtt"
mqtt_password: "changeme"

# Optional: iSolarCloud device SN (only needed if the ext-flash identity can't be read).
# cloud_sn: "B2xxxxxxxxx"
