{
  "name": "rewired-s-web",
  "version": "0.9.0",
  "private": true,
  "description": "On-device TypeScript SPA shell for the Sungrow WiNet dongle (served by the sungrow_web ESPHome component).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "serve": "node esbuild.config.mjs --serve",
    "test": "node esbuild.config.mjs --test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
